#!/bin/env envman
# vi: ft=bash

IMAGE_NAME="greenplum-6-ubuntu-22"
CONTAINER_NAME="gpdb_6_u22_default"
PORT_PREFIX="6"
PORT_VARIATION="16"

case "$(hostname)" in
  'void')
    SRC_DIR="$HOME/Work/Arenadata/src"
    GPDB_SUBDIR="gpdb"
  ;;
  'fennec' | 'kitten' | 'catfish')
    SRC_DIR="$HOME/Work"
    GPDB_SUBDIR="greenplum"
  ;;
  *)
    if test -z "$SRC_DIR" -o -z "$GPDB_SUBDIR"
    then
      echo "ERROR: unknown gpdb path!" >&2
      exit 1
    fi
  ;;
esac

source "$ENV_DIR/aux/image-base.sh"
